---
import { profile } from "../data/profile";

interface Props {
  number: string;
}
const { number } = Astro.props;
---

<section class="border-b border-cream-300 py-20 dark:border-white/10">
  <div class="grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <span
        class="text-xs font-semibold uppercase tracking-[0.08em] text-cream-700 dark:text-cream-400"
        >{number} · Education</span
      >
      <h2
        class="mt-3 text-3xl font-normal leading-tight tracking-tight md:text-4xl"
      >
        Business training, technical depth.
      </h2>
      <p class="mt-5 text-sm/relaxed text-cream-700 dark:text-cream-400">
        Graduated summa cum laude with a computer science minor, then an MS in
        Business Analytics.
      </p>
    </div>
    <ol class="divide-y divide-cream-300 lg:col-span-8 dark:divide-white/10">
      {
        profile.education.map((item) => (
          <li class="grid grid-cols-12 gap-4 py-5 first:pt-0">
            <div class="col-span-12 sm:col-span-3">
              <span class="font-mono text-xs text-cream-700 dark:text-cream-400">
                {item.period}
              </span>
            </div>
            <div class="col-span-12 sm:col-span-9">
              <h3 class="text-[1.25rem] font-normal leading-snug tracking-tight">
                {item.degree}
              </h3>
              <p class="mt-1 text-sm font-medium text-cream-700 dark:text-cream-400">
                {item.institution}
                {item.location && (
                  <span class="text-cream-600 dark:text-cream-500">
                    {" · "}{item.location}
                  </span>
                )}
              </p>
              {item.honors && item.honors.length > 0 && (
                <ul class="mt-3 flex flex-wrap gap-2">
                  {item.honors.map((honor) => (
                    <li class="rounded-full bg-cream-200/70 px-2.5 py-1 text-xs font-medium text-cream-800 dark:bg-white/10 dark:text-cream-300">
                      {honor}
                    </li>
                  ))}
                </ul>
              )}
              {item.note && (
                <p class="mt-3 text-sm/relaxed text-cream-700 dark:text-cream-400">{item.note}</p>
              )}
              {item.certifications && item.certifications.length > 0 && (
                <ul class="mt-3 space-y-1 text-sm text-cream-700 dark:text-cream-400">
                  {item.certifications.map((cert) => (
                    <li>
                      <span class="font-medium text-cream-900 dark:text-cream-200">{cert.name}</span>{`, ${cert.issuer} (${cert.date})`}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
