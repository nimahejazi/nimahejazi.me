---
import { profile } from "../data/profile";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  number: string;
}
const { number } = Astro.props;

const active = profile.projects.filter((p) => !p.archived);
const featured = active.filter((p) => p.featured);
const secondary = active.filter((p) => !p.featured);
const hasArchive = profile.projects.some((p) => p.archived);
---

<section
  id="projects"
  class="border-b border-cream-300 py-20 dark:border-white/10"
>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <span
        class="text-xs font-semibold uppercase tracking-[0.08em] text-cream-700 dark:text-cream-400"
        >{number} · Projects</span
      >
      <h2
        class="mt-3 text-3xl font-normal leading-tight tracking-tight md:text-4xl"
      >
        Things I've built and shipped.
      </h2>
    </div>
    {
      hasArchive && (
        <a
          href="/archive"
          class="text-sm font-medium text-cream-900 underline decoration-cream-400 underline-offset-4 hover:decoration-cream-900 dark:text-white dark:decoration-white/30 dark:hover:decoration-white"
        >
          See the archive →
        </a>
      )
    }
  </div>

  <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {featured.map((project) => <ProjectCard project={project} />)}
  </div>

  {
    secondary.length > 0 && (
      <div class="mt-4 grid gap-4 md:grid-cols-2">
        {secondary.map((project) => <ProjectCard project={project} />)}
      </div>
    )
  }
</section>
