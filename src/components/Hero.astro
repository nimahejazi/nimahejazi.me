---
import { profile } from "../data/profile";
---

<section class="border-b border-cream-300 py-16 md:py-20 dark:border-white/10">
  <div class="grid gap-10 md:grid-cols-12 md:gap-12 lg:gap-16">
    <div class="md:col-span-7">
      <p class="text-sm font-medium text-cream-900 dark:text-white">
        {profile.name}
        <span class="text-cream-600 dark:text-cream-500"> · {profile.role}</span>
      </p>
      {
        profile.availableForWork && (
          <span class="mt-3 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.08em] text-cream-700 dark:text-cream-400">
            <span class="size-1.5 rounded-full bg-brand-500" />
            Available for work · {profile.location} · open to relocation
          </span>
        )
      }
      <h1
        class="mt-6 text-4xl font-normal leading-[1.05] tracking-[-0.03em] sm:text-5xl lg:text-6xl"
      >
        {profile.headline}<span class="text-brand-500">.</span>
      </h1>
      <p
        class="mt-6 max-w-2xl text-base/relaxed text-cream-700 dark:text-cream-400"
      >
        {profile.pitch}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="#projects"
          class="inline-flex h-10 items-center gap-2 rounded-md bg-brand-500 px-5 text-sm font-medium text-white hover:bg-brand-600"
        >
          See my work
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-4"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
        <a
          href={profile.resume}
          download
          class="inline-flex h-10 items-center gap-2 rounded-md border border-cream-400 bg-white px-5 text-sm font-medium text-cream-900 hover:bg-cream-50 dark:border-white/15 dark:bg-transparent dark:text-white dark:hover:bg-white/5"
        >
          Download resume
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-4"
            aria-hidden="true"
          >
            <path d="M12 3v12"></path>
            <path d="m7 10 5 5 5-5"></path>
            <path d="M5 21h14"></path>
          </svg>
        </a>
        <a
          href="#contact"
          class="inline-flex h-10 items-center px-2 text-sm font-medium text-cream-900 underline decoration-cream-400 underline-offset-4 hover:decoration-cream-900 dark:text-white dark:decoration-white/30 dark:hover:decoration-white"
        >
          Get in touch
        </a>
      </div>

      <dl
        class="mt-12 grid max-w-2xl grid-cols-1 gap-5 border-t border-cream-300 pt-8 sm:grid-cols-3 sm:gap-6 dark:border-white/10"
      >
        {
          profile.stats.map((stat) => (
            <div class="flex items-baseline justify-between gap-4 sm:block">
              <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-cream-700 dark:text-cream-400">
                {stat.label}
              </dt>
              <dd class="text-right sm:mt-1 sm:text-left">
                <span class="block text-[1.625rem] font-normal leading-tight tracking-tight">
                  {stat.value}
                </span>
                {stat.sub && (
                  <span class="mt-1 block text-sm text-cream-600 dark:text-cream-500">
                    {stat.sub}
                  </span>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="md:col-span-5">
      <div
        class="relative h-full overflow-hidden rounded-xl border border-cream-300 bg-white dark:border-white/10 dark:bg-white/5"
      >
        <img
          src={profile.portrait}
          class="aspect-4/5 w-full object-cover md:aspect-auto md:h-full"
          alt={`${profile.name} portrait`}
        />
      </div>
    </div>
  </div>
</section>
