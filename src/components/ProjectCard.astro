---
import type { ProjectItem } from "../data/profile";

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
const detailHref = project.slug ? `/projects/${project.slug}/` : undefined;
const href = detailHref ?? project.href;
const fit = project.imageFit === "contain" ? "object-contain p-3" : "object-cover object-top";
---

<article
  class="group relative flex flex-col overflow-hidden rounded-xl border border-cream-300 bg-white transition hover:border-cream-400 dark:border-white/10 dark:bg-white/5 dark:hover:border-white/20"
>
  {
    project.image && (
      <div class="aspect-16/10 overflow-hidden border-b border-cream-300 bg-cream-100 dark:border-white/10 dark:bg-white/5">
        <img
          src={project.image}
          alt={project.imageAlt ?? ""}
          loading="lazy"
          class={`h-full w-full ${fit} transition-transform duration-300 group-hover:scale-[1.02]`}
        />
      </div>
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-[1.25rem] font-normal leading-snug tracking-tight">
      {
        href ? (
          <a
            href={href}
            class="after:absolute after:inset-0 after:content-[''] group-hover:text-brand-600 dark:group-hover:text-brand-400"
          >
            {project.title}
          </a>
        ) : (
          project.title
        )
      }
    </h3>
    <p class="mt-3 flex-1 text-sm/relaxed text-cream-700 dark:text-cream-400">
      {project.description}
    </p>
    <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Technologies">
      {
        project.tags.map((tag) => (
          <li class="rounded-full bg-cream-200/70 px-2.5 py-0.5 text-xs font-medium text-cream-800 dark:bg-white/10 dark:text-cream-300">
            {tag}
          </li>
        ))
      }
    </ul>
    {
      href && (
        <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-brand-600 dark:text-brand-400">
          {detailHref ? "Read the case study" : href.replace(/^https?:\/\//, "")}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-3.5 transition-transform group-hover:translate-x-0.5"
            aria-hidden="true"
          >
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </span>
      )
    }
  </div>
</article>
