---
import { profile } from "../data/profile";

interface Props {
  number: string;
}
const { number } = Astro.props;
---

<section
  id="about"
  class="border-b border-cream-300 py-20 dark:border-white/10"
>
  <div class="grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <span
        class="text-xs font-semibold uppercase tracking-[0.08em] text-cream-700 dark:text-cream-400"
        >{number} · About</span
      >
      <h2
        class="mt-3 text-3xl font-normal leading-tight tracking-tight md:text-4xl"
      >
        Founder first, then a degree to match.
      </h2>
    </div>

    <div class="min-w-0 lg:col-span-8">
      <div class="max-w-2xl space-y-4 text-base/relaxed text-cream-800 dark:text-cream-300">
        {profile.story.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <dl class="mt-10 grid gap-6 sm:grid-cols-2">
        {
          profile.skills.map((group) => (
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.08em] text-cream-700 dark:text-cream-400">
                {group.category}
              </dt>
              <dd class="mt-2 text-sm/relaxed text-cream-900 dark:text-cream-200">
                {group.items.join(" · ")}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
