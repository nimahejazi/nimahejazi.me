---
import { profile } from "../data/profile";

interface Props {
  number: string;
}
const { number } = Astro.props;
---

<section
  id="experience"
  class="border-b border-cream-300 py-20 dark:border-white/10"
>
  <div class="grid gap-12 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <span
        class="text-xs font-semibold uppercase tracking-[0.08em] text-cream-700 dark:text-cream-400"
        >{number} · Experience</span
      >
      <h2
        class="mt-3 text-3xl font-normal leading-tight tracking-tight md:text-4xl"
      >
        Three businesses, one campus, one law school.
      </h2>
      <p class="mt-5 text-sm/relaxed text-cream-700 dark:text-cream-400">
        I've sold the work, built it, and supported it afterward, for my own
        customers and for the teams I worked with.
      </p>
    </div>

    <ul class="space-y-3 lg:col-span-8">
      {
        profile.experience.map((item) => (
          <li class="rounded-xl border border-cream-300 bg-white p-6 dark:border-white/10 dark:bg-white/5">
            <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
              <h3 class="text-[1.25rem] font-normal leading-snug tracking-tight">
                {item.company}
              </h3>
              <span class="font-mono text-xs text-cream-700 dark:text-cream-400">
                {item.period}
              </span>
            </div>
            <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
              {item.founder && (
                <span class="rounded-full bg-brand-500/10 px-2 py-0.5 text-xs font-semibold text-brand-700 dark:bg-brand-400/15 dark:text-brand-300">
                  Founder
                </span>
              )}
              {!(item.founder && item.title === "Founder") && (
                <span class="font-medium text-cream-900 dark:text-cream-100">{item.title}</span>
              )}
              {item.location && (
                <span class="text-cream-600 dark:text-cream-500">· {item.location}</span>
              )}
            </p>
            <ul class="mt-4 list-disc space-y-2 pl-5 text-sm/relaxed text-cream-700 marker:text-cream-400 dark:text-cream-400">
              {item.highlights.map((point) => (
                <li>
                  {typeof point === "string" ? (
                    point
                  ) : (
                    <a
                      href={point.href}
                      class="font-medium text-brand-600 underline decoration-brand-300 underline-offset-4 hover:decoration-brand-600 dark:text-brand-400"
                    >
                      {point.text} →
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
